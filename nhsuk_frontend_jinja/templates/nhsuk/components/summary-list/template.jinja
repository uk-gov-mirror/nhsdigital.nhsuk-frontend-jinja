{% from "nhsuk/macros/attributes.jinja" import nhsukAttributes %}
{% from "nhsuk/components/card/macro.jinja" import card %}
{% from "nhsuk/components/summary-list/row/macro.jinja" import summaryListRow %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-summary-list" -%}

{%- if params.border is sameas false and not (params.classes and "nhsuk-summary-list--no-border" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-summary-list--no-border" %}
{% elif params.lastRowBorder is sameas false and not (params.classes and "nhsuk-summary-list--no-last-row-border" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-summary-list--no-last-row-border" %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set rows = params.rows | select("mapping") | list if params.rows | length else [] %}

{#- Determine if we need 2 or 3 columns #}
{%- set state = namespace(hasActions=false) %}
{% for row in rows %}
  {% if row.actions
    and row.actions["items"] is defined
    and row.actions["items"] | length
  %}
    {% set state.hasActions = true %}
  {% endif %}
{% endfor -%}

{%- set summaryList %}
<dl class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %} {{- nhsukAttributes(params.attributes) }}>
{% if caller %}
  {{- caller() }}
{% elif params.html %}
  {{ params.html | safe | trim | indent(2) }}
{% else %}
  {% for row in rows %}
    {{- summaryListRow(row, {
      "params": params,
      "loop": loop,
      "rows": rows,
      "classNames": classNames,
      "hasActions": state.hasActions
    }) | trim | indent(2, true) }}
  {% endfor %}
{% endif %}
</dl>
{%- endset %}

{%- if params.card -%}
  {% call card(params.card) -%}
    {{ summaryList | safe | trim | indent(4) }}
  {%- endcall %}
{%- else -%}
  {{ summaryList | safe | trim }}
{% endif %}
